{
  "name": "@tank-radar/backend",
  "private": true,
  "version": "0.0.0",
  "main": "dist/core/server.js",
  "scripts": {
    "dev": "ts-node src/core/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/src/core/server.js",
    "lint": "eslint ./**/*.{ts,js}",
    "format": "prettier --write ./**/*.{ts,js,json,md}",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests -t .*"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.60.0",
    "@packages/enum": "*",
    "@packages/types": "*",
    "@packages/utils": "*",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.5",
    "eslint": "^9.13.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  }
}
